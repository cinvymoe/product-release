# 制品通道 —— 大文件不入 git, 由 deploy/lib/sync.sh 从 NAS 拉取
/artifacts/**
!/artifacts/.gitkeep
!/artifacts/MANIFEST.sha256
!/artifacts/*.example

# 客户自定义实例不入 git (只留模板)
/custom/*
!/custom/example/
# 运行时自动解压的工具目录 (保留 zip 即可, 解压产物不提交)
/tools/windows/platform-tools/
/tools/windows/upgrade_tool_v2.46_for_window/
